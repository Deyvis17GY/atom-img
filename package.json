{
  "name": "@deyvis17gy/atom-img",
  "version": "2.0.0",
  "description": "image preloading for slow or large connections",
  "author": {
    "email": "deyvisjaime17@gmail.com",
    "name": "Deyvis Mariños"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deyvis17GY/atom-img.git"
  },
  "homepage": "https://deyvis17gy.github.io/atom-img/",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ui",
    "react",
    "library",
    "design system"
  ],
  "scripts": {
    "build": "run-s build:js build:css",
    "build:js": "tsup",
    "build:css": "sass --no-source-map --style=compressed src/picture.scss dist/index.css",
    "dev": "run-p \"build:js -- --watch\" \"build:css -- --watch\"",
    "prepare": "run-s build",
    "test": "run-s test:lint test:types test:unit build",
    "test:lint": "eslint .",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "deploy:netlify:storybook": "storybook build && netlify deploy --dir storybook-static --prod",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.104.0",
    "semantic-release": "^24.2.9",
    "storybook": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
